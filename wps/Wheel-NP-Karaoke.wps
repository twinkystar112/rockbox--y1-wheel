# Wheel - Now Playing, karaoke (lyrics under the song) for 480x360 (Innioasis Y1)
# Original design for the Rockbox Y1 Wheel edition. GPLv2+.
# "#@ old=new" lines adapt the line below them (Typography & Fonts settings).
# A template only: Settings > Appearance > Now Playing writes the skin in use
# (wps/Wheel-Pal.wps or Wheel-Aero.wps) from it, with the colours of the palette.
%wd
#@ Wheel-Secondary.fnt=${secondary}
%Fl(2,Wheel-Secondary.fnt)
#@ Wheel-Title.fnt=${title}
%Fl(3,Wheel-Title.fnt)
%Fl(4,22-Wheel-Icons.fnt)
#@ Wheel-Display.fnt=${display}
%Fl(5,Wheel-Display.fnt)
#@ Wheel-Meta.fnt=${meta}
%Fl(6,Wheel-Meta.fnt)
%Fl(7,18-Wheel-Icons.fnt)
%Fl(8,110-Wheel-Icons.fnt)
#@ Wheel-Numeric.fnt=${numeric}
%Fl(9,Wheel-Numeric.fnt)
#
# ---------- top bar ----------
%V(0,0,480,38,-)%Vb(f7f7f9)
%dr(0,37,-,1,c8c8ce)
# (Settings > Appearance > Top bar: battery percentage and clock)
%?St(battery percentage)<%Vd(tb_pct)%?St(wheel bar clock)<%Vd(tb_icons_pc)|%Vd(tb_icons_p)>|%?St(wheel bar clock)<%Vd(tb_icons_c)|%Vd(tb_icons)>>
%?St(wheel bar clock)<%Vd(tb_title_c)%Vd(tb_clock)|%?St(battery percentage)<%Vd(tb_title_p)|%Vd(tb_title)>>
%Vd(tb_bat)%?bc<%Vd(tb_ok)|%?if(%bl,<,11)<%Vd(tb_low)|%?if(%bl,<,21)<%Vd(tb_mid)|%Vd(tb_ok)>>>
%Vl(tb_title,16,2,280,32,3)%Vf(141415)%Vb(f7f7f9)
%s%Sx(Now Playing)
%Vl(tb_title_p,16,2,230,32,3)%Vf(141415)%Vb(f7f7f9)
%s%Sx(Now Playing)
%Vl(tb_title_c,16,2,164,32,3)%Vf(141415)%Vb(f7f7f9)
%s%Sx(Now Playing)
%Vl(tb_clock,184,8,112,22,9)%Vf(141415)%Vb(f7f7f9)
%ac%?St(time format)<%cH:%cM|%cl:%cM>
%Vl(tb_icons,300,7,124,24,4)%Vf(3a3a3e)%Vb(f7f7f9)
%ar%?Wq<S |>%?Wb<H |>%?mp<D|B|C|P|Q|B|C>%?bc< V|>
%Vl(tb_icons_p,250,7,124,24,4)%Vf(3a3a3e)%Vb(f7f7f9)
%ar%?Wq<S |>%?Wb<H |>%?mp<D|B|C|P|Q|B|C>%?bc< V|>
%Vl(tb_icons_c,300,7,124,24,4)%Vf(3a3a3e)%Vb(f7f7f9)
%ar%?Wq<S |>%?Wb<H |>%?mp<D|B|C|P|Q|B|C>%?bc< V|>
%Vl(tb_icons_pc,300,7,74,24,4)%Vf(3a3a3e)%Vb(f7f7f9)
%ar%?Wq<S |>%?Wb<H |>%?mp<D|B|C|P|Q|B|C>%?bc< V|>
%Vl(tb_pct,376,8,50,22,9)%Vf(3a3a3e)%Vb(f7f7f9)
%ar%?if(%bl,>,-1)<%bl%%|>
%Vl(tb_bat,430,10,44,18,-)%Vf(3a3a3e)%Vb(f7f7f9)
%dr(0,0,38,18,3a3a3e)%dr(2,2,34,14,f7f7f9)%dr(0,0,1,1,f7f7f9)%dr(37,0,1,1,f7f7f9)%dr(0,17,1,1,f7f7f9)%dr(37,17,1,1,f7f7f9)%dr(38,5,3,8,3a3a3e)%dr(40,5,1,1,f7f7f9)%dr(40,12,1,1,f7f7f9)
%Vl(tb_ok,433,13,32,12,-)%Vf(2fbf5b)%Vb(f7f7f9)
%bl(0,0,32,12,noborder)
%Vl(tb_mid,433,13,32,12,-)%Vf(f0a020)%Vb(f7f7f9)
%bl(0,0,32,12,noborder)
%Vl(tb_low,433,13,32,12,-)%Vf(e5413a)%Vb(f7f7f9)
%bl(0,0,32,12,noborder)
#
# ---------- artwork (soft shadow + cover, or a placeholder tile) ----------
# ("#@aero" lines: the glossy finish has a reflection instead of the shadow)
%V(24,52,126,126,-)
#@aero %dr(4,5,122,121,e6e6ea)=#
%dr(4,5,122,121,e6e6ea)
#@aero %dr(2,3,122,121,d4d4da)=#
%dr(2,3,122,121,d4d4da)
%Cl(0,0,120,120,c,c)
%?C<%Vd(art)|%Vd(tile)%Vd(note)>
#@aero 120,120,-)=120,134,-)
%Vl(art,24,52,120,120,-)
%Cd
%Vl(tile,24,52,120,120,-)%Vb(cfcfd6)
%dr(0,0,-,-,cfcfd6)
%Vl(note,24,57,120,110,8)%Vb(cfcfd6)%Vf(fffffe)
%Vs(none)%dr(0,0,-,-,cfcfd6)%acO
#
# ---------- the song, beside the cover ----------
%V(164,52,292,32,5)%Vf(141416)
%s%?it<%it|%fn>
%V(164,88,292,26,2)%Vf(accent)
%s%?ia<%ia|%?iA<%iA|>>
%V(164,116,292,26,2)%Vf(6e6e73)
%s%?St(wheel np album)<%?id<%id|>|>
%V(164,150,200,22,6)%Vf(8e8e93)
%pp %Sx(of) %pe
# shuffle / repeat (the %Vd switches sit on this always-visible line)
%V(364,148,92,24,7)%Vf(accent)
%ar%?ps<E |>%?mm<|F|G|E|F>%?Wy<%Vd(kara)|%Vd(nolyr)>%?Wm<%?mv(1.5)<%Vd(vol)|%?St(wheel np bar)<%Vd(prog)|%Vd(progt)>>|%Vd(scrub)>
#
# ---------- karaoke: the line being sung, big, between the ones around it ----------
%Vl(kara,24,190,432,22,6)%Vf(8e8e93)
%ac%s%?Wp<%Wp|>
%Vl(kara,24,216,432,32,5)%Vf(accent)
%ac%s%?Wc<%Wc|· · ·>
%Vl(kara,24,254,432,22,6)%Vf(8e8e93)
%ac%s%?Wn<%Wn|>
#
# no lyrics: say so, and what comes next
%Vl(nolyr,24,206,432,26,2)%Vf(8e8e93)
%ac%Sx(No lyrics for this song)
%Vl(nolyr,24,238,432,22,6)%Vf(8e8e93)
%ac%s%?It<%Sx(Up Next): %It|>
#
# ---------- progress, volume while the wheel turns, or scrubbing ----------
#
%Vl(prog,24,294,432,6,-)%Vf(accent)%Vb(dcdce1)
%pb(0,0,432,6,noborder)
%Vl(prog,24,305,200,22,9)%Vf(6e6e73)
%pc
%Vl(prog,256,305,200,22,9)%Vf(6e6e73)
%ar-%pr
#
# the thick progress bar
%Vl(progt,24,290,432,12,-)%Vf(accent)%Vb(dcdce1)
%pb(0,0,432,12,noborder)
%Vl(progt,24,308,200,22,9)%Vf(6e6e73)
