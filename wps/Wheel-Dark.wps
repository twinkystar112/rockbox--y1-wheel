# Wheel Dark - Now Playing for 480x360 (Innioasis Y1)
# Original design for the Rockbox Y1 Wheel edition. GPLv2+.
# "#@ old=new" lines adapt the line below them (Typography & Fonts settings).
%wd
#@ Wheel-Secondary.fnt=${secondary}
%Fl(2,Wheel-Secondary.fnt)
#@ Wheel-Title.fnt=${title}
%Fl(3,Wheel-Title.fnt)
%Fl(4,22-Wheel-Icons.fnt)
#@ Wheel-Display.fnt=${display}
%Fl(5,Wheel-Display.fnt)
#@ Wheel-Meta.fnt=${meta}
%Fl(6,Wheel-Meta.fnt)
%Fl(7,18-Wheel-Icons.fnt)
%Fl(8,110-Wheel-Icons.fnt)
#@ Wheel-Numeric.fnt=${numeric}
%Fl(9,Wheel-Numeric.fnt)
#
# ---------- top bar ----------
%V(0,0,480,38,-)%Vb(1c1c1f)
%dr(0,37,-,1,38383c)
%V(16,2,280,32,3)%Vf(f2f2f5)%Vb(1c1c1f)
%Sx(Now Playing)
%V(300,7,124,24,4)%Vf(e5e5ea)%Vb(1c1c1f)
%ar%?Wq<S |>%?Wb<H |>%?mp<D|B|C|P|Q|B|C>
%V(426,7,46,24,4)%Vf(e5e5ea)%Vb(1c1c1f)
%ar%?bc<N|%?bl<I|J|K|L|M>>
#
# ---------- artwork (soft shadow + cover, or a placeholder tile) ----------
%V(24,60,206,206,-)
%dr(4,5,202,201,050506)
%dr(2,3,202,201,1f1f22)
%Cl(0,0,200,200,c,c)
%?C<%Vd(art)|%Vd(tile)%Vd(note)>
%Vl(art,24,60,200,200,-)
%Cd
%Vl(tile,24,60,200,200,-)%Vb(2c2c31)
%dr(0,0,-,-,2c2c31)
%Vl(note,24,104,200,112,8)%Vb(2c2c31)%Vf(8e8e93)
%Vs(none)%dr(0,0,-,-,2c2c31)%acO
#
# ---------- track text ----------
#@ %V(248,57,=%V(248,${np1},
%V(248,57,220,22,6)%Vf(8e8e93)
%pp %Sx(of) %pe
#@ %V(248,85,=%V(248,${np2},
%V(248,85,220,32,5)%Vf(f2f2f5)
%s%?it<%it|%fn>
#@ %V(248,122,=%V(248,${np3},
%V(248,122,220,26,2)%Vf(accent)
%s%?ia<%ia|%?iA<%iA|>>
#@ %V(248,150,=%V(248,${np4},
%V(248,150,220,26,2)%Vf(a1a1a8)
%s%?id<%id|>
#@ %V(248,183,=%V(248,${np5},
%V(248,183,220,22,6)%Vf(8e8e93)
%s%?iy<%iy · |>%?fc<MP1|MP2|MP3|AIFF|WAV|Ogg|FLAC|MPC|AC3|WavPack|ALAC|AAC|SHN|SID|ADX|NSF|Speex|SPC|APE|WMA|Opus|> · %fb kbps
#
# shuffle / repeat state (accent colour when active) + lyrics hint
%V(248,224,40,24,7)%Vf(accent)
%?ps<E|>
# (the %Vd switches sit on this always-visible line: a %Vd inside a
#  labelled viewport only runs when that viewport is shown)
%V(282,224,40,24,7)%Vf(accent)
%?mm<|F|G|E|F>%?Wy<%Vd(lyr)|>%?Wm<%?mv(1.5)<%Vd(vol)|%Vd(prog)>|%Vd(scrub)>
%Vl(lyr,322,223,146,22,6)%Vf(accent)
%ar%Sx(Lyrics)
#
# ---------- progress, volume while the wheel turns, or scrubbing ----------
#
%Vl(prog,24,294,432,6,-)%Vf(accent)%Vb(3a3a3f)
%pb(0,0,432,6,noborder)
%Vl(prog,24,305,200,22,9)%Vf(a1a1a8)
%pc
%Vl(prog,256,305,200,22,9)%Vf(a1a1a8)
%ar-%pr
#
%Vl(vol,24,286,30,24,7)%Vf(e5e5ea)
R
%Vl(vol,58,294,398,6,-)%Vf(accent)%Vb(3a3a3f)
%pv(0,0,398,6,noborder)
%Vl(vol,24,305,432,22,9)%Vf(a1a1a8)
%ac%pv dB
#
# scrubbing: thicker bar with a knob, big times, a hint
%Vl(scrub,24,290,432,12,-)%Vf(accent)%Vb(3a3a3f)
%pb(0,0,432,12,noborder)
%Vl(scrub,24,308,120,22,9)%Vf(f2f2f5)
%pc
%Vl(scrub,144,307,192,22,6)%Vf(8e8e93)
%ac%Sx(Scrubbing)
%Vl(scrub,336,308,120,22,9)%Vf(f2f2f5)
%ar-%pr
