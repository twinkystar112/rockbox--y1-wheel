%V(296,204,172,22,6)%Vf(8e8e93)
%s%?St(wheel np next)<%?It<%Sx(Up Next): %It|>|>
# (the %Vd switches sit on an always-visible line)
%V(296,238,40,24,7)%Vf(accent)
%?ps<E|>
%V(330,238,40,24,7)%Vf(accent)
%?mm<|F|G|E|F>%?Wm<%?mv(1.5)<%Vd(vol)|%?St(wheel np bar)<%Vd(prog)|%Vd(progt)>>|%Vd(scrub)>
#
# ---------- progress, volume while the wheel turns, or scrubbing ----------
%Vl(prog,296,300,172,6,-)%Vf(accent)%Vb(dcdce1)
%pb(0,0,172,6,noborder)
%Vl(prog,296,312,86,22,9)%Vf(6e6e73)
