# Wheel - status bar + menus for 480x360 (Innioasis Y1)
# Original design for the Rockbox Y1 Wheel edition. GPLv2+.
# Fonts: Inter (SIL OFL) and the generated Wheel-Icons / Wheel-Row fonts.
# Colours: Settings > Appearance > Palette rewrites them (see
# apps/wheel/wheel_palette.c for which colour is which).
# A "#@ old=new" line adapts the line below it ("\s" = a space) for Settings > Appearance >
# Typography & Fonts (which writes Wheel-Type.sbs); ${role} = that role's font.
#
#@ 40-Wheel-Row.fnt=${row}
%Fl(2,40-Wheel-Row.fnt)
#@ 40-Wheel-RowSel.fnt=${rowsel}
%Fl(3,40-Wheel-RowSel.fnt)
%Fl(4,22-Wheel-Icons.fnt)
%Fl(5,110-Wheel-Icons.fnt)
#@ Wheel-Meta.fnt=${meta}
%Fl(6,Wheel-Meta.fnt)
#@ Wheel-Secondary.fnt=${secondary}
%Fl(7,Wheel-Secondary.fnt)
#@ Wheel-Title.fnt=${title}
%Fl(8,Wheel-Title.fnt)
#@ Wheel-Numeric.fnt=${numeric}
%Fl(9,Wheel-Numeric.fnt)
#@ Wheel-Numeric.fnt=${jumbo}
%Fl(10,Wheel-Numeric.fnt)
#
# ---------- UI viewport: split screen on the main menu ----------
%Vi(full,0,38,480,322,2)
%Vi(half,0,38,264,322,2)
# (Settings > Appearance > Main menu > Right pane: cover, clock, up next, none)
%?cs<%?St(wheel pane)<%VI(half)|%VI(half)|%VI(half)|%VI(full)>|%VI(full)>
#
# ---------- list rows (40px). Values sit on the right, then the chevron ----------
#@ 480,40)=480,${row_h})
%Lb(item,480,40)
#@ -,40,=-,${row_h},
%Vl(item,0,0,-,40,2)%Vf(141416)%Vb(ffffff)
#@ |\s\s\s%LT=|${pad}%LT %Lv\s\s=%Lv${rpad} ›\s\s=›${rpad}
%?Lc<|   %LT%ar%?Lv<%Lv  |>%?Lh<›  |>>
#@ -,40,=-,${row_h},
%Vl(item,0,0,-,40,3)%Vg(accent2,accent,accenttext)
#@ )\s\s\s%LT=)${pad}%LT %Lv\s\s=%Lv${rpad} ›\s\s=›${rpad}
%?Lc<%Vs(gradient)   %LT%ar%?Lv<%Lv  |>%?Lh<›  |>|>
#
# ---------- right pane: what's playing (main menu only) ----------
%Vl(pane,264,38,216,322,-)%Vb(f2f2f5)
%dr(0,0,1,-,d1d1d6)
#
%Cl(0,0,184,184,c,c)
%Vl(art,280,56,184,184,-)%Vb(f2f2f5)
%Cd
# (the tile is painted with %dr and the note drawn without clearing, so it
#  also works over the backdrop of the glossy finish)
%Vl(tile,280,56,184,184,-)%Vb(cfcfd6)
%dr(0,0,-,-,cfcfd6)
%Vl(note,280,92,184,112,5)%Vb(cfcfd6)%Vf(fffffe)
%Vs(none)%dr(0,0,-,-,cfcfd6)%acO
#
%Vl(cap1,272,247,200,26,7)%Vf(141416)%Vb(f2f2f5)
%ac%s%?it<%it|%fn>
%Vl(cap2,272,275,200,22,6)%Vf(6e6e73)%Vb(f2f2f5)
%ac%s%?ia<%ia|%?iA<%iA|>>
%Vl(mini,292,314,160,4,-)%Vf(accent)%Vb(d6d6dc)
%pb(0,0,160,4,noborder)
#
# library being built on the first start
%Vl(lib,272,250,200,44,6)%Vf(6e6e73)%Vb(f2f2f5)
%ac%Wd
#
# the clock pane
%Vl(clock,272,86,200,76,10)%Vf(141416)%Vb(f2f2f5)
%ac%?St(time format)<%cH:%cM|%cl:%cM>
%Vl(clock,272,168,200,26,7)%Vf(6e6e73)%Vb(f2f2f5)
%ac%ca %cd %cb
#
# the "up next" pane
%Vl(next,272,56,200,22,6)%Vf(8e8e93)%Vb(f2f2f5)
%ac%Sx(Now Playing)
%Vl(next,272,80,200,26,7)%Vf(141416)%Vb(f2f2f5)
%ac%s%?it<%it|%fn>
%Vl(next,272,108,200,22,6)%Vf(accent)%Vb(f2f2f5)
%ac%s%?ia<%ia|%?iA<%iA|>>
%Vl(next,292,148,160,1,-)
%dr(0,0,-,-,d1d1d6)
%Vl(next,272,162,200,22,6)%Vf(8e8e93)%Vb(f2f2f5)
%ac%Sx(Up Next)
%Vl(next,272,186,200,26,7)%Vf(141416)%Vb(f2f2f5)
%ac%s%?It<%It|%?Fn<%Fn|->>
%Vl(next,272,214,200,22,6)%Vf(6e6e73)%Vb(f2f2f5)
%ac%s%?Ia<%Ia|>
#
# ---------- top bar ----------
%V(0,0,480,38,-)%Vb(f7f7f9)
%dr(0,37,-,1,c8c8ce)
%?cs<%?St(wheel pane)<%Vd(pane)|%Vd(pane)|%Vd(pane)|>|>
%?cs<%?St(wheel pane)<%?C<%Vd(art)|%Vd(tile)%Vd(note)>|%Vd(clock)|%?mp<%Vd(clock)|%Vd(next)>|>|>
%?cs<%?St(wheel pane)<%?mp<%?Wd<%Vd(lib)|>|%Vd(cap1)%Vd(cap2)%Vd(mini)>|%?mp<|%Vd(cap1)%Vd(cap2)%Vd(mini)>|%?mp<|%Vd(mini)>|>|>
%?St(battery percentage)<%Vd(pct)%Vd(icons_pct)|%Vd(icons)>
%V(16,2,300,32,8)%Vf(141415)%Vb(f7f7f9)
%s%?Lt<%Lt|Rockbox>
#
# status icons: scrobbles waiting, Bluetooth headphones, play state
%Vl(icons,300,7,124,24,4)%Vf(3a3a3e)%Vb(f7f7f9)
%ar%?Wq<S |>%?Wb<H |>%?mp<|B|C|P|Q|B|C>
%Vl(icons_pct,250,7,124,24,4)%Vf(3a3a3e)%Vb(f7f7f9)
%ar%?Wq<S |>%?Wb<H |>%?mp<|B|C|P|Q|B|C>
%Vl(pct,376,8,50,22,9)%Vf(3a3a3e)%Vb(f7f7f9)
%ar%?if(%bl,>,-1)<%bl%%|>
#
# battery (charging bolt while on the charger)
%V(426,7,46,24,4)%Vf(3a3a3e)%Vb(f7f7f9)
%ar%?bc<N|%?bl<I|J|K|L|M>>
